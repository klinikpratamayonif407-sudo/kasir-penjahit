{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/daftar$", "dest": "/api/daftar.php" },
    { "src": "^/simpan$", "dest": "/api/simpan_pesanan.php" },
    { "src": "^/hapus$", "dest": "/api/hapus.php" },
    { "src": "^/edit$", "dest": "/api/edit.php" },
    { "src": "^/update$", "dest": "/api/update.php" },
    { "src": "^/update-status$", "dest": "/api/update_status.php" }
  ]
}